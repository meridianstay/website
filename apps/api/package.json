{
  "name": "@meridian/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.emulators --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env.emulators --env-file-if-exists=.env src/store/seed.ts",
    "test": "firebase emulators:exec --config ../../firebase.test.json --project demo-meridianstay-test --only auth,firestore,storage 'tsx --test --test-concurrency=1 src/tests/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@meridian/shared": "*",
    "firebase-admin": "^14.4.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@meridian/tsconfig": "*",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
