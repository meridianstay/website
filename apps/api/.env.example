# Postgres connection. Locally this defaults to postgres://localhost:5432/meridianstay_dev.
# On Vercel, adding Neon from the Storage tab sets DATABASE_URL for you.
DATABASE_URL=postgres://localhost:5432/meridianstay_dev

# Add demo listings and accounts to an empty database outside development (e.g. a test deployment).
SEED_DEMO_DATA=false

# Share the login between subdomains, e.g. .meridianstay.com. Leave empty for path-based hosting.
COOKIE_DOMAIN=
