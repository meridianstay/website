# Production (Vercel): the Firebase service-account JSON from Project settings → Service accounts.
# Paste the whole JSON (or a base64 copy). Keep it secret.
FIREBASE_SERVICE_ACCOUNT=

# Only if your bucket isn't <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Load demo listings and accounts into an empty project (client previews only).
SEED_DEMO_DATA=false

# Share the login between subdomains, e.g. .meridianstay.com. Leave empty for path-based hosting.
COOKIE_DOMAIN=
